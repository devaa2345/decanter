# Sovereign chat bot — environment configuration.
#
# Copy this file to `.env` in the same folder and fill in the values. The
# real .env is git-ignored and never leaves your machine.
#
# IMPORTANT: this file configures your LOCAL machine only. The deployed bot
# reads its values from Render → your service → Environment, where every key
# below marked "sync: false" in render.yaml has to be entered by hand. A key
# filled in here and not there is a key production does not have.
#
# Nothing below is required to open the console and browse or edit the
# catalog locally — with Supabase unset the console skips the login screen
# entirely. Each block says what you lose by leaving it blank.


# --- WhatsApp sending -------------------------------------------------------
# Without this the bot can match a perfume and build a reply but has no way
# to deliver it. Required in production; leave blank locally unless you
# genuinely want messages going out.
CHATMITRA_API_TOKEN=

# Signs inbound webhooks so nobody else can post fake customer messages to
# your endpoint. Blank = signature checking is skipped, which is fine on your
# machine and must be set before go-live. Must match the secret configured on
# the WhatsApp provider's dashboard exactly.
CHATMITRA_WEBHOOK_SECRET=


# --- The LLM layer ----------------------------------------------------------
# Groq reads intent and phrasing. It never chooses a perfume and never sees a
# price. Blank = the deterministic matcher answers alone, which it is built
# to do — you lose some phrasing quality, not correctness.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=6.0


# --- Supabase ---------------------------------------------------------------
# Powers four things: the dashboard login, analytics, catalog version history,
# and — the one that bites — a human-handoff pause that survives a restart.
# With these blank the pause works only for as long as the process stays up,
# and on Render's free plan the service sleeps when idle. See /health, which
# reports exactly this.
#
# The SERVICE ROLE key, not the anon key: row-level security blocks the anon
# key from writing. Find both under Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The single email allowed to sign in to the console. Blank = any account in
# your Supabase project can sign in, which is almost certainly not what you
# want on a public URL.
OWNER_EMAIL=


# --- Matching behaviour -----------------------------------------------------
# The recall/precision dial. Lower tolerates more mangled spelling at the cost
# of more wrong guesses; higher makes the bot stay silent more often. 4.0 was
# chosen by benchmarking every product in the catalog against 17 kinds of
# typo — do not move it without re-running scripts/benchmark_matcher.py.
MATCH_MIN_SCORE=4.0

# Messages longer than this get the catalog reply instead of going through
# matching — past a few hundred characters a message is a conversation, not
# somebody naming a perfume.
MAX_MESSAGE_LENGTH=500


# --- Conversation memory ----------------------------------------------------
# How many recent turns the bot remembers per customer, and for how long.
# This is what lets "and 5ml?" resolve against the card just sent.
CONVERSATION_TURNS=6
CONVERSATION_TTL_SECONDS=1800


# --- Duplicate-webhook protection ------------------------------------------
# Providers retry a webhook they think failed. These stop a retry becoming a
# second identical reply to the customer.
DEDUP_TTL_SECONDS=300
DEDUP_MAX_SIZE=1000
